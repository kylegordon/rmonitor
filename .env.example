# Copy to .env and fill in real values for this deployment.
# .env is git-ignored — see up.sh for which variables it must provide.
RMONITOR_HOST=192.168.10.24
RMONITOR_PORT=50000
SERVER_URL=https://your-server.example.com
RELAY_SECRET=change-me
# 0 stops the relay reading class codes from the timing host's port 51738.
CLASS_CODES_ENABLED=1
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
